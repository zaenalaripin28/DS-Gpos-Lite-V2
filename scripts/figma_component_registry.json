{
  "version": "1.0.0",
  "sourceOfTruth": [
    "styles/tokens.css",
    "styles/gp-lite-design-tokens.json",
    "components/*/*.html",
    "src/GposLite/styles/*.css",
    "Docs/figma-generate-skill.md",
    "Docs/figma-make-context.md",
    "Docs/component-rules.md",
    "Docs/components-index.md"
  ],
  "buildPhases": [
    {
      "id": "foundations",
      "label": "Foundations",
      "items": [
        "foundations/colors/colors.html",
        "foundations/typography/typography.html",
        "foundations/spacing/spacing.html",
        "foundations/borders/borders.html",
        "foundations/shadows/shadows.html",
        "foundations/grid/grid.html",
        "foundations/icons/icons.html"
      ]
    },
    {
      "id": "atoms",
      "label": "Atoms",
      "componentIds": ["avatar", "badge", "button", "checkbox", "lozenge", "radio", "tags", "toggle", "tooltip", "range"]
    },
    {
      "id": "inputs",
      "label": "Inputs",
      "componentIds": ["text-field", "text-area", "select"]
    },
    {
      "id": "molecules",
      "label": "Molecules",
      "componentIds": ["dropdown", "pagination", "tabs", "calendar", "date-picker", "time-picker", "date-time-picker", "inline-edit", "breadcrumbs"]
    },
    {
      "id": "feedback",
      "label": "Feedback & Overlays",
      "componentIds": ["section-messages", "toast-banner", "flags", "modal", "popup", "tourguide"]
    },
    {
      "id": "data",
      "label": "Data",
      "componentIds": ["table"]
    },
    {
      "id": "navigation",
      "label": "Navigation",
      "componentIds": ["navigation-menu", "top-bottom-navigation"]
    },
    {
      "id": "layout",
      "label": "Layout & Shell",
      "componentIds": ["page-header", "form", "page-layout"]
    }
